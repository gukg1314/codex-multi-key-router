      "css": ".ds-navigation{display:flex;height:var(--nav-height);gap:var(--nav-gap);padding:0 var(--page-pad-x);background:var(--accent);color:var(--accent-ink)}.ds-navigation button{position:relative;border:0;background:transparent;color:inherit;padding:0 2px;font:500 14px var(--sans);white-space:nowrap;cursor:pointer}.ds-navigation button[aria-current=\"page\"]{font-weight:700}.ds-navigation button[aria-current=\"page\"]:after{content:\"\";position:absolute;bottom:14px;left:2px;right:2px;height:2px;background:var(--bg)}.ds-navigation button:hover{color:var(--accent-faint)}.ds-navigation button:focus-visible{outline:3px solid var(--accent-ink);outline-offset:3px}"
